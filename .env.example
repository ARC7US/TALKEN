# TALKEN Environment Variables

# Server
PORT=3001
HOST=0.0.0.0

# Blockchain mode: mock | testnet | mainnet
STELLAR_MODE=mock

# IOTA (required when STELLAR_MODE=testnet or mainnet)
IOTA_ADMIN_PRIVATE_KEY=
TALKEN_CONTRACT_PACKAGE_ID=
TREASURY_CAP_ID=
ADMIN_CAP_ID=

# Distribution mode: testnet | mainnet
DISTRIBUTION_MODE=testnet

# Allocation wallet addresses (for distribute-tokens.ts)
# TALKEN_WALLETS=team=0x...,ecosystem=0x...,privateSale=0x...,publicSale=0x...,foundation=0x...,liquidity=0x...,airdrop=0x...,advisors=0x...
TALKEN_WALLETS=
