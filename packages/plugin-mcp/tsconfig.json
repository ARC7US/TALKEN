{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "declaration": true,
    "skipLibCheck": true,
    "paths": {
      "@talken/agent-sdk": ["../agent-sdk/src/index.ts"],
      "@talken/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "../agent-sdk/src", "../shared/src"]
}
